# Telegram bridge for opencode: settings.
# Copy to ~/.config/opencode/telegram.env and keep it private:  chmod 600 ~/.config/opencode/telegram.env

# Bot token from @BotFather (required)
TELEGRAM_BOT_TOKEN=

# Password for new users: whoever sends it to the bot is authorised for good
# (the list is kept in ~/.config/opencode/telegram-users.json). Change it from the chat: /password <new>
TELEGRAM_PASSWORD=

# Optional static allow-list of chat or user ids, comma separated (see /who)
TELEGRAM_ALLOWED=

# opencode agent for Telegram messages (agent/telegram.md)
TELEGRAM_AGENT=telegram

# Default model, provider/model as in opencode.json (empty: the opencode default)
TELEGRAM_MODEL=

# Tool permissions: ask (buttons in the chat) | allow | deny
TELEGRAM_PERMISSIONS=ask

# Slow-inference timings, in minutes
# abort a run only after this much total silence (never while it waits for a button)
TELEGRAM_STUCK_MIN=20
# how long a confirmation button waits before it rejects itself
TELEGRAM_PERMISSION_MIN=10

# 1 = verbose event log
TELEGRAM_DEBUG=0
